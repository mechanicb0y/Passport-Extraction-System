PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Option 1: point to a Google service account JSON file on your machine.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option 2: paste service account JSON as one environment variable instead.
# GOOGLE_CLOUD_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id"}

# Optional when Application Default Credentials already know the project.
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
